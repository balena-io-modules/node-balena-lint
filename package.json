{
  "name": "@balena/lint",
  "version": "10.0.0",
  "description": "Balena.io eslint & prettier wrapper",
  "type": "module",
  "bin": {
    "balena-lint": "./bin/balena-lint"
  },
  "main": "./build/balena-lint.js",
  "homepage": "https://github.com/balena-io-modules/node-balena-lint",
  "repository": {
    "type": "git",
    "url": "git@github.com:balena-io-modules/node-balena-lint"
  },
  "files": [
    "tsconfig.json",
    "bin/",
    "build/",
    "config/"
  ],
  "scripts": {
    "build": "tsc -P tsconfig.build.json && npm run lint-fix && npm run lint",
    "lint": "node ./bin/balena-lint -t tsconfig.json lib/ config/eslint.config.js",
    "prepublish": "require-npm4-to-publish",
    "prepublishOnly": "npm run test",
    "lint-fix": "node ./bin/balena-lint -t tsconfig.json --fix -e ts -e js lib/ config/eslint.config.js",
    "test": "npm run build && npm run test:typescript",
    "test:typescript": "node ./bin/balena-lint -t tsconfig.json test/typescript/prettier -i",
    "prepare": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "keywords": [
    "balena",
    "lint",
    "typescript",
    "prettier"
  ],
  "author": "Balena.io. <hello@balena.io>",
  "license": "Apache 2.0",
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/yargs": "17.0.35",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "require-npm4-to-publish": "1.0.0"
  },
  "versionist": {
    "publishedAt": "2026-10-25T22:54:11.776Z"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=9.8.1"
  }
}
